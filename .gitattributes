# Third-party tooling is preserved byte-for-byte from its project-scoped
# installation. Authored repository files retain Git's default whitespace checks.
.claude/skills/impeccable/** -whitespace linguist-vendored

# Vite may embed literal whitespace characters, including newlines, inside the
# minified JavaScript. The source and reproducibility checks validate this output.
internal/report/assets/app.js -whitespace linguist-generated
internal/report/assets/app.css -whitespace linguist-generated
